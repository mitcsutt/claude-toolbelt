#!/usr/bin/env bash
# Stand-in for `web/serve.py --sidecar`: announces itself on stdout exactly the way
# the real observer does, then stays alive so the harness has a pid to supervise and
# to kill on exit. Wired in via LOOP_DASHBOARD_CMD.
#
# `exec` replaces this shell with `sleep` rather than running it as a child: the
# real dashboard is one process with no children, and a test that simulates an
# external kill (`kill -9` on just this pid, the way an OOM killer or a crash
# would) must not orphan a grandchild `sleep` that nothing then reaps.
printf '%s\n' '{"type":"dashboard-started","url":"http://127.0.0.1:1","loop_dir":"x"}'
exec sleep 3600
