#!/usr/bin/env bash
# Mock `claude` for stream-json. Ignores flags/stdin. Emits the Nth block of
# $MOCK_CLAUDE_SCRIPT (blocks separated by a line equal to '==='). If a block's
# first line is 'RC=<n>', exit with that code (and don't print that line). If a
# block's first line is 'SLEEP=<s>', sleep that long first (and don't print it) —
# used to hold a tick open while a second harness races for the lock.
#
# Non-tick invocations (the harness also shells out to `claude --print "/skill"`)
# must NOT consume a block, or every medic/postmortem call would eat a tick:
#   /agent-loop-medic      -> run $MOCK_MEDIC_SCRIPT if set (args passed through), else exit 0
#   /agent-loop-postmortem -> exit 0
for arg in "$@"; do
  case "$arg" in
    */agent-loop-medic*)
      if [[ -n "${MOCK_MEDIC_SCRIPT:-}" ]]; then
        bash "$MOCK_MEDIC_SCRIPT" "$@"
        exit "$?"
      fi
      exit 0 ;;
    */agent-loop-postmortem*)
      exit 0 ;;
  esac
done

state="${MOCK_CLAUDE_STATE:?MOCK_CLAUDE_STATE unset}"
script="${MOCK_CLAUDE_SCRIPT:?MOCK_CLAUDE_SCRIPT unset}"
cat >/dev/null 2>&1 || true   # drain stdin
n=0; [[ -f "$state" ]] && n="$(cat "$state")"
n=$((n + 1)); echo "$n" > "$state"
block="$(awk -v want="$n" 'BEGIN{b=1} /^===$/{b++; next} { if (b==want) print }' "$script")"
exit_code=0
first="$(printf '%s\n' "$block" | head -1)"
if [[ "$first" == SLEEP=* ]]; then
  sleep "${first#SLEEP=}"
  block="$(printf '%s\n' "$block" | tail -n +2)"
  first="$(printf '%s\n' "$block" | head -1)"
fi
if [[ "$first" == RC=* ]]; then
  exit_code="${first#RC=}"
  block="$(printf '%s\n' "$block" | tail -n +2)"
fi
printf '%s\n' "$block"
exit "$exit_code"
