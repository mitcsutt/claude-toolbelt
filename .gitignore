.DS_Store
*.log
node_modules/
__pycache__/
.env
.env.local
# ccstatusline writes backups and atomic-write temp files into its config dir,
# which is this directory once ~/.config/ccstatusline is symlinked here.
config/ccstatusline/*.bak
config/ccstatusline/*.tmp

# Superpowers artefacts: specs are tracked (design rationale is durable),
# plans and sdd scaffolding are not (transient execution state).
docs/superpowers/plans/
.superpowers/

# claude plugin eval's default --output-dir: run artefacts, not suite content.
plugins/*/evals/results/
