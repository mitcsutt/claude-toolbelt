// Static assets only, as a kiln-docs site deploys (ADR 0034). No routes: the custom domain is
// attached to the Worker outside this repo.
{
  "name": "claude-toolbelt-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
