{
  "name": "claude-toolbelt-site",
  "version": "0.0.0",
  "private": true,
  "description": "The claude-toolbelt documentation site, built on @mitcsutt/kiln-docs",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "node scripts/generate.ts && next dev",
    "build": "node scripts/generate.ts && next build && kiln-docs postbuild",
    "check-links": "kiln-docs check-links",
    "typecheck": "node scripts/generate.ts && fumadocs-mdx && tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@mitcsutt/kiln-docs": "0.1.0",
    "@mitcsutt/kiln-ui": ">=0.8.0 <1.0.0",
    "fumadocs-core": "~16.17.8",
    "fumadocs-mdx": "15.4.10",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
